{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DeskMate",
  "version": "../package.json",
  "identifier": "io.github.swonlee615.deskmate",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "DeskMate",
        "width": 900,
        "height": 730,
        "minWidth": 380,
        "minHeight": 480,
        "backgroundColor": "#1B1D21",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 13,
          "y": 15
        }
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true,
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "deskmate"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVENDQzNzUzQThEOTE2NjkKUldScEZ0bW9VemRFN1ZKdjRLZFQzcnAyc3R3NmczZGVibk1DMVl1QWpxMXBKTVdVRW5HdVBFNTkK",
      "endpoints": [
        "https://github.com/swonlee615/DeskMate-prod/releases/latest/download/latest.json"
      ]
    }
  }
}
