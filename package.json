{
  "name": "deskmate-web",
  "private": true,
  "version": "3.2.5",
  "type": "module",
  "description": "DeskMate 웹 우선 버전 — PC 앱 · 브라우저 · iOS/Android PWA 가 같은 코드를 쓴다",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
