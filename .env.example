# Firebase 콘솔 → 프로젝트 설정 → 내 앱(웹) 에서 복사한 값.
# 직접 채우기보다 「Firebase-연결.command」 를 더블클릭해 붙여 넣는 쪽이 쉽다.
# 비워 두면 앱은 «개발 모드 · 이 기기에만 저장» 으로 돈다 (로그인 없음).
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_APP_ID=

# 로그인 화면에 보일 방식 (쉼표로 구분: google, apple, email). 지금은 google 만
VITE_AUTH_PROVIDERS=google
